        {
          "name": "Players sorted by ACS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/players?sort=acs&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "acs"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"descending ACS\", () => {",
                  "  const acs = pm.response.json().value.map(p => p.acs);",
                  "  pm.expect(acs).to.eql([...acs].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        },
