{
  "info": {
    "name": "VCT Hub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD + paging tests for the VCT Hub REST API (C5, B1, QA1)."
  },
  "item": [
    {
      "name": "Read",
      "item": [
        {
          "name": "Regions list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/regions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "regions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"five regions incl. EMEA\", () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r).to.have.lengthOf(5);",
                  "  pm.expect(r.map(x => x.code)).to.include(\"emea\");",
                  "  pm.collectionVariables.set(\"regionId\", r.find(x => x.code === \"emea\").id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Teams page 1 (limit 5)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teams?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"page shape\", () => {",
                  "  pm.expect(p).to.have.all.keys(\"value\", \"count\", \"skip\", \"limit\", \"nextLink\");",
                  "  pm.expect(p.value).to.have.lengthOf(5);",
                  "  pm.expect(p.skip).to.eql(0);",
                  "});",
                  "pm.test(\"nextLink points at skip=5\", () => pm.expect(p.nextLink).to.include(\"skip=5\"));",
                  "pm.collectionVariables.set(\"nextLink\", p.nextLink);",
                  "pm.collectionVariables.set(\"firstTeam\", p.value[0].name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Teams page 2 via nextLink",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"second page starts after the first\", () => {",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.skip).to.eql(5);",
                  "  pm.expect(p.value[0].name).to.not.eql(pm.collectionVariables.get(\"firstTeam\"));",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.url = pm.collectionVariables.get(\"nextLink\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Last page has no nextLink",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teams?skip=1000&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "1000"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"empty, nextLink null\", () => {",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.value).to.be.empty;",
                  "  pm.expect(p.nextLink).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Limit is capped at 100",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
