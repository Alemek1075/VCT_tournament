@section Head {
<style>
    .site-footer { display: none; }
    .chat { max-width: 860px; margin: 0 auto; display: flex; flex-direction: column; height: calc(100vh - 62px); }
    .chat-log { flex: 1; overflow-y: auto; padding: 1.5rem 0; }
    .msg { margin-bottom: 1.2rem; }
    .msg.user .bubble { background: var(--ink-3); border: 1px solid var(--line); margin-left: auto; max-width: 80%; }
    .msg .bubble { padding: .8rem 1rem; width: fit-content; max-width: 100%; }
    .msg.bot .bubble { padding-left: 0; }
    .bubble p:last-child { margin-bottom: 0; }
    .bubble a { color: var(--red); }
    .bubble table { font-size: .9rem; }
    .who { font-family: "Barlow Condensed"; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; color: var(--muted); margin-bottom: .3rem; }
    .steps { margin: .4rem 0 .6rem; display: grid; gap: .35rem; }
    .step { border: 1px solid var(--line); background: var(--ink-2); font-size: .85rem; }
    .step summary { padding: .35rem .7rem; cursor: pointer; list-style: none; display: flex; gap: .5rem; align-items: center; }
    .step summary::-webkit-details-marker { display: none; }
    .step pre { margin: 0; padding: .6rem .8rem; border-top: 1px solid var(--line); max-height: 260px; overflow: auto; font-size: .75rem; color: #b9c2c9; }
    .step.thinking summary { color: var(--muted); font-style: italic; }
    .step .spin { width: 10px; height: 10px; border: 2px solid var(--muted); border-top-color: var(--red); border-radius: 50%; animation: spin .8s linear infinite; }
    .step.ok .spin { animation: none; border-color: var(--teal); background: var(--teal); }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .caret::after { content: "▍"; animation: blink 1s steps(1) infinite; color: var(--red); }
    @@keyframes blink { 50% { opacity: 0; } }
    .composer { display: flex; gap: .5rem; padding: 1rem 0 1.2rem; border-top: 1px solid var(--line); }
    .composer textarea { resize: none; }
    .suggest { display: flex; flex-wrap: wrap; gap: .4rem; }
    .suggest button { font-size: .85rem; }
</style>
}
<div class="container-xl">
    <div class="chat">
        <div class="chat-log" id="log">
            <div class="page-head" id="intro">
                <div class="kicker">C21 · Gemini + tools · streamed</div>
                <h1>AI analyst</h1>
                <p class="muted">It searches the VCT Hub database while answering. You'll see every tool call as it happens.</p>
                <div class="suggest">
                    <button class="btn btn-ghost btn-sm">Who are the top 5 duelists by rating?</button>
                    <button class="btn btn-ghost btn-sm">How did FNATIC do this season?</button>
                    <button class="btn btn-ghost btn-sm">Compare aspas and Derke</button>
                    <button class="btn btn-ghost btn-sm">What's live right now?</button>
                    @if (User.Identity?.IsAuthenticated == true) { <button class="btn btn-ghost btn-sm">Write an anti-Paper Rex game plan and save it to my docs</button> }
                </div>
            </div>
        </div>
        <form class="composer" id="form">
            <textarea class="form-control" id="input" rows="2" placeholder="Ask about teams, players, matches… (Enter to send)" maxlength="4000"></textarea>
            <button class="btn btn-red" id="send">Send</button>
        </form>
    </div>
</div>
@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js"></script>
<script>
(() => {
    const $log = document.getElementById('log'), $input = document.getElementById('input'), $send = document.getElementById('send');
    const history = [];
    const md = s => DOMPurify.sanitize(marked.parse(s));
    const esc = s => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
    const scroll = () => $log.scrollTo({ top: $log.scrollHeight });

    function bubble(role) {
        document.getElementById('intro')?.remove();
        const el = document.createElement('div');
        el.className = 'msg ' + role;
        el.innerHTML = `<div class="who">${role === 'user' ? 'You' : 'VCT analyst'}</div><div class="steps"></div><div class="bubble"></div>`;
        $log.appendChild(el);
        return el;
    }

    async function ask(text) {
        history.push({ role: 'user', text });
        bubble('user').querySelector('.bubble').textContent = text;
        const bot = bubble('bot'), $steps = bot.querySelector('.steps'), $text = bot.querySelector('.bubble');
        $text.classList.add('caret');
        $send.disabled = true;
        let answer = '', thinking = null;
        const pending = {};
        window.track?.('agent_question', { length: text.length });

        try {
            const res = await fetch('/api/agent/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history }) });
            if (res.status === 429) throw new Error('Too many questions — wait a minute (free Gemini quota).');
            if (!res.ok) throw new Error('Server said ' + res.status);
            // read the SSE stream by hand: EventSource can't POST
            const reader = res.body.getReader(), dec = new TextDecoder();
            let buf = '';
            for (;;) {
                const { value, done } = await reader.read();
                if (done) break;
                buf += dec.decode(value, { stream: true });
                let i;
                while ((i = buf.indexOf('\n\n')) >= 0) {
                    const raw = buf.slice(0, i); buf = buf.slice(i + 2);
                    const type = raw.match(/^event: (.*)$/m)?.[1], data = JSON.parse(raw.match(/^data: (.*)$/m)?.[1] ?? 'null');
                    if (type === 'thinking') {
                        if (!thinking) { thinking = document.createElement('details'); thinking.className = 'step thinking'; thinking.innerHTML = '<summary>💭 Thinking…</summary><pre></pre>'; $steps.appendChild(thinking); }
                        thinking.querySelector('pre').textContent += data;
                    } else if (type === 'tool_call') {
                        thinking = null;
                        const d = document.createElement('details'); d.className = 'step';
                        d.innerHTML = `<summary><span class="spin"></span><strong>${esc(data.name)}</strong> <span class="muted">${esc(JSON.stringify(data.args))}</span></summary><pre>calling…</pre>`;
                        $steps.appendChild(d); (pending[data.name] ??= []).push(d);
                    } else if (type === 'tool_result') {
                        const d = pending[data.name]?.shift();
                        if (d) { d.classList.add('ok'); d.querySelector('summary').insertAdjacentHTML('beforeend', `<span class="muted ms-auto">${data.ms} ms</span>`); d.querySelector('pre').textContent = JSON.stringify(data.result, null, 2); }
                    } else if (type === 'text') {
                        answer += data; $text.innerHTML = md(answer);
                    } else if (type === 'error') {
                        $text.innerHTML += `<p class="text-danger">${esc(data.message)}</p>`;
                    }
                    scroll();
                }
            }
        } catch (e) {
            $text.innerHTML += `<p class="text-danger">${esc(e.message)}</p>`;
        }
        $text.classList.remove('caret');
        if (answer) history.push({ role: 'model', text: answer });
        $send.disabled = false; $input.focus(); scroll();
    }

    document.getElementById('form').addEventListener('submit', e => { e.preventDefault(); const t = $input.value.trim(); if (t && !$send.disabled) { $input.value = ''; ask(t); } });
    $input.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); document.getElementById('form').requestSubmit(); } });
    document.querySelectorAll('.suggest button').forEach(b => b.addEventListener('click', () => ask(b.textContent)));
})();
</script>
}
