@model Tournament
@{ ViewData["Title"] = Model.Name; }
<div class="container-xl">
    <div class="page-head d-flex flex-wrap gap-4 align-items-center">
        <img src="@Model.LogoUrl" alt="" style="width:100px;height:100px;object-fit:contain" />
        <div class="me-auto">
            <div class="kicker">@Model.Stage · @Model.Region?.Name</div>
            <h1>@Model.Name</h1>
            <div class="muted">
                @Model.StartDate.ToString("MMM d") – @Model.EndDate.ToString("MMM d, yyyy") · @Model.Venue
                @if (Model.PrizePool > 0) { <text>· $@Model.PrizePool.Value.ToString("N0")</text> }
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-ghost" asp-controller="Matches" asp-action="Create" asp-route-tournamentId="@Model.Id">+ Match</a>
            <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <h2 class="h4">Matches</h2>
            <div class="panel">
                @foreach (var m in Model.Matches.OrderBy(m => m.ScheduledAt)) { <partial name="_MatchRow" model="m" /> }
                @if (Model.Matches.Count == 0) { <p class="p-3 m-0 muted">No matches yet.</p> }
            </div>
        </div>
        <div class="col-lg-4">
            <h2 class="h4">Teams</h2>
            <div class="d-grid gap-2">
                @foreach (var t in Model.Teams)
                {
                    <a class="team-card py-2" href="/team/@t.Slug"><img class="logo-sm" src="@t.LogoUrl" alt="" /> <span>@t.Name</span></a>
                }
            </div>
        </div>
    </div>
</div>
