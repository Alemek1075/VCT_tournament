@model PagedList<Team>
@{
    ViewData["Title"] = "Teams";
    var region = ViewBag.Region as string;
}
<div class="container-xl">
    <div class="page-head d-flex flex-wrap align-items-end gap-3">
        <div class="me-auto">
            <div class="kicker">@Model.Total organisations</div>
            <h1>Teams</h1>
        </div>
        <form class="d-flex gap-2" method="get">
            <input class="form-control" name="q" value="@Model.Query" placeholder="Search team or tag" />
            @if (region != null) { <input type="hidden" name="region" value="@region" /> }
            <button class="btn btn-ghost">Find</button>
        </form>
        <a class="btn btn-red" asp-action="Create">+ New team</a>
    </div>

    <div class="d-flex gap-2 flex-wrap mb-4">
        <a class="tag @(region == null ? "live" : "")" asp-action="Index" asp-route-q="@Model.Query">All</a>
        @foreach (Region r in ViewBag.Regions)
        {
            <a class="tag @(region == r.Code ? "live" : "")" asp-action="Index" asp-route-region="@r.Code" asp-route-q="@Model.Query">@r.Name</a>
        }
    </div>

    <div class="row g-3">
        @foreach (var t in Model.Items)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <a class="team-card" href="/team/@t.Slug">
                    <img class="logo-md" src="@t.LogoUrl" alt="@t.Name logo" loading="lazy" />
                    <div class="min-w-0">
                        <div class="name">@t.Name</div>
                        <div class="muted small">@t.Tag · @t.Region?.Name</div>
                    </div>
                </a>
            </div>
        }
    </div>
    @if (Model.Items.Count == 0) { <p class="muted">No teams match.</p> }
    <partial name="_Pager" model="(Model.Page, Model.Pages)" />
</div>
