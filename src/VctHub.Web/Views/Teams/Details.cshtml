@model TeamPageVm
@{
    var t = Model.Team;
    ViewData["Title"] = t.Name;
}
<div class="container-xl">
    <div class="page-head d-flex flex-wrap gap-4 align-items-center">
        <img src="@t.LogoUrl" alt="@t.Name logo" style="width:120px;height:120px;object-fit:contain" />
        <div class="me-auto">
            <div class="kicker">@t.Region?.Name · @t.Country</div>
            <h1>@t.Name</h1>
            <div class="muted">@t.Tag @(t.City is null ? "" : $"· {t.City}")</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
            <a class="btn btn-ghost" asp-controller="Players" asp-action="Create" asp-route-teamId="@t.Id">+ Player</a>
        </div>
    </div>

    <h2 class="h4">Roster</h2>
    <div class="row g-3 mb-4">
        @foreach (var p in t.Players)
        {
            <div class="col-6 col-md-4 col-lg">
                <a class="team-card flex-column text-center" asp-controller="Players" asp-action="Details" asp-route-id="@p.Id">
                    <img src="@(p.PhotoUrl ?? t.LogoUrl)" alt="@p.Nickname" style="width:100%;aspect-ratio:1;object-fit:cover" loading="lazy" />
                    <div class="name">@p.Nickname</div>
                    <div class="muted small">@p.Role · @p.Rating</div>
                </a>
            </div>
        }
    </div>

    <h2 class="h4">Matches</h2>
    <div class="panel">
        @foreach (var m in Model.Matches) { <partial name="_MatchRow" model="m" /> }
    </div>
</div>
