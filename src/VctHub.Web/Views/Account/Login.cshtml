@model LoginInput
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-shell">
    <partial name="_AuthAside" />
    <div class="auth-box">
        <div class="kicker">VCT Hub account</div>
        <h1>Sign in</h1>
        <p class="muted mb-4">Welcome back. Pick up where you left off.</p>

        @if (ViewBag.Google == true)
        {
            <form method="post" asp-action="External" class="mb-3">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <partial name="_GoogleButton" model="@("Continue with Google")" />
            </form>
            <div class="or"><span>or with email</span></div>
        }
        <form method="post" asp-route-returnUrl="@ViewBag.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Remember" class="form-check-input" />
                <label asp-for="Remember" class="form-check-label">Keep me signed in</label>
            </div>
            <button class="btn btn-red btn-lg w-100">Sign in</button>
        </form>
        <p class="muted mt-3">No account? <a asp-action="Register" class="text-danger">Create one</a></p>
    </div>
</div>
