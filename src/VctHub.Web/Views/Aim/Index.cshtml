@section Head {
<style>
    .site-footer { display: none; }
    .aim-shell { display: grid; grid-template-columns: 1fr 300px; gap: 1.5rem; padding: 1.5rem 0; }
    .aim-stage { position: relative; background: #0a1117; border: 1px solid var(--line); aspect-ratio: 16 / 9; overflow: hidden; }
    .aim-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: none; touch-action: none; }
    .aim-hud { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; padding: .6rem 1rem; font-family: "Barlow Condensed"; font-weight: 700; font-size: 1.4rem; pointer-events: none; text-transform: uppercase; }
    .aim-overlay { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; background: rgba(10,17,23,.82); }
    .aim-overlay[hidden] { display: none; }
    .aim-overlay h2 { font-size: 2.6rem; margin: 0; }
    .modes { display: flex; gap: .5rem; justify-content: center; margin: 1rem 0; }
    .modes button.on { border-color: var(--red); color: var(--paper); }
    .lb td, .lb th { font-size: .9rem; }
    @@media (max-width: 900px) { .aim-shell { grid-template-columns: 1fr; } }
</style>
}
<div class="container-xl">
    <div class="aim-shell">
        <div>
            <div class="aim-stage" id="stage">
                <canvas id="game" aria-label="Aim trainer"></canvas>
                <div class="aim-hud"><span id="hud-score">0</span><span id="hud-time">30.0</span><span id="hud-acc">100%</span></div>
                <div class="aim-overlay" id="overlay">
                    <div>
                        <div class="kicker text-danger display">Aim trainer</div>
                        <h2 id="ov-title">Click to start</h2>
                        <div class="modes">
                            <button class="btn btn-ghost on" data-mode="gridshot">Gridshot</button>
                            <button class="btn btn-ghost" data-mode="flick">Flick</button>
                        </div>
                        <p class="muted" id="ov-text">30 seconds. Center hits score more. Misses break your combo.</p>
                        <button class="btn btn-red" id="start">Start</button>
                        <p class="muted small mt-2" id="ov-save"></p>
                    </div>
                </div>
            </div>
            <p class="muted small mt-2">Canvas 2D + requestAnimationFrame, hit sounds from the Web Audio API. Esc stops the round.</p>
        </div>
        <aside>
            <h2 class="h4">Leaderboard · <span id="lb-mode">gridshot</span></h2>
            <table class="table lb"><thead><tr><th>#</th><th>Player</th><th class="text-end">Score</th><th class="text-end">ms</th></tr></thead><tbody id="lb"></tbody></table>
            <p class="muted small" id="best"></p>
            @if (User.Identity?.IsAuthenticated != true) { <p class="small"><a href="/account/login?ReturnUrl=/aim" class="text-danger">Sign in</a> to get on the board.</p> }
        </aside>
    </div>
</div>
@section Scripts {
<script>window.AIM = { signedIn: @(User.Identity?.IsAuthenticated == true ? "true" : "false") };</script>
<script src="~/js/aim.js" asp-append-version="true"></script>
}
