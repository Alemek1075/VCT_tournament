@model Player
@{ ViewData["Title"] = $"Edit {Model.Nickname}"; }
<div class="container-xl">
    <div class="page-head d-flex align-items-end">
        <div class="me-auto"><div class="kicker">Players</div><h1>@Model.Nickname</h1></div>
        <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
    <partial name="_Form" model="Model" />
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
