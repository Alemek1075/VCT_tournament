@model Player
@{ ViewData["Title"] = Model.Nickname; }
<div class="container-xl">
    <div class="page-head d-flex flex-wrap gap-4 align-items-center">
        <img src="@(Model.PhotoUrl ?? Model.Team?.LogoUrl)" alt="@Model.Nickname" style="width:140px;height:140px;object-fit:cover;background:var(--ink-2)" />
        <div class="me-auto">
            <div class="kicker">@Model.Role @(Model.MainAgent is null ? "" : $"· {Model.MainAgent}")</div>
            <h1>@Model.Nickname @if (Model.IsCaptain) { <span class="tag">Captain</span> }</h1>
            <div class="muted">@Model.RealName @(Model.CountryCode is null ? "" : $"· {Model.CountryCode.ToUpperInvariant()}")</div>
            @if (Model.Team != null)
            {
                <a class="d-inline-flex align-items-center gap-2 mt-2" href="/team/@Model.Team.Slug">
                    <img class="logo-sm" src="@Model.Team.LogoUrl" alt="" /> @Model.Team.Name
                </a>
            }
            @if (Model.RankedAccount != null)
            {
                <div class="muted small mt-1">Ranked: @Model.RankedAccount.RiotId · @Model.RankedAccount.Rank</div>
            }
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        </div>
    </div>

    <div class="row g-3 mb-4 text-center">
        @foreach (var (label, value) in new[] { ("Rating", Model.Rating.ToString()), ("ACS", Model.Acs.ToString()), ("K:D", Model.Kd.ToString()),
                      ("ADR", Model.Adr.ToString()), ("KAST", $"{Model.Kast}%"), ("HS%", $"{Model.Hs}%"), ("Maps", Model.Maps.ToString()) })
        {
            <div class="col"><div class="panel p-3"><div class="display fs-2 fw-bold">@value</div><div class="muted small">@label</div></div></div>
        }
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <h2 class="h4">Form across the season</h2>
            <div class="panel p-3"><canvas id="trend" height="220" aria-label="Rating and ACS per event"></canvas></div>
        </div>
        <div class="col-lg-5">
            <h2 class="h4">vs average @(Model.Role ?? "player")</h2>
            <div class="panel p-3"><canvas id="radar" height="220" aria-label="Comparison with role average"></canvas></div>
        </div>
    </div>

    <h2 class="h4">By event</h2>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Event</th><th>Agent</th><th class="text-end">Maps</th><th class="text-end">Rating</th><th class="text-end">ACS</th><th class="text-end">K:D</th><th class="text-end">ADR</th></tr></thead>
            <tbody>
            @foreach (var s in Model.EventStats.OrderBy(s => s.Tournament!.StartDate))
            {
                <tr>
                    <td><a asp-controller="Tournaments" asp-action="Details" asp-route-id="@s.TournamentId">@s.Tournament!.Name</a></td>
                    <td class="muted">@s.TopAgent</td>
                    <td class="text-end">@s.Maps</td>
                    <td class="text-end"><strong>@s.Rating</strong></td>
                    <td class="text-end">@s.Acs</td>
                    <td class="text-end">@s.Kd</td>
                    <td class="text-end">@s.Adr</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(async () => {
    Chart.defaults.color = '#a49d97';
    Chart.defaults.borderColor = '#362e2e';
    Chart.defaults.font.family = 'Barlow';
    const [stats, roles] = await Promise.all([
        fetch('/api/players/@Model.Id/stats').then(r => r.json()),
        fetch('/api/players/roles').then(r => r.json()),
    ]);
    const short = n => n.replace('VCT 2026: ', '').replace('Valorant ', '').replace(' 2026', '');

    new Chart(document.getElementById('trend'), {
        data: {
            labels: stats.map(s => short(s.tournament)),
            datasets: [
                { type: 'line', label: 'Rating', data: stats.map(s => s.rating), yAxisID: 'r', borderColor: '#ff4655', backgroundColor: '#ff4655', tension: .3, pointRadius: 5 },
                { type: 'bar', label: 'ACS', data: stats.map(s => s.acs), yAxisID: 'a', backgroundColor: 'rgba(63,209,180,.35)' },
            ],
        },
        options: {
            interaction: { mode: 'index', intersect: false },
            scales: { r: { position: 'left', suggestedMin: .7, suggestedMax: 1.4, title: { display: true, text: 'Rating' } },
                      a: { position: 'right', grid: { display: false }, suggestedMin: 150, title: { display: true, text: 'ACS' } } },
        },
    });

    const avg = roles.find(r => r.role === '@Model.Role');
    if (!avg) { document.getElementById('radar').replaceWith('Not enough data for this role.'); return; }
    // each axis scaled against the role average, so 100 = typical @(Model.Role)
    const me = { rating: @Model.Rating.ToString(System.Globalization.CultureInfo.InvariantCulture), acs: @Model.Acs, kd: @Model.Kd.ToString(System.Globalization.CultureInfo.InvariantCulture), adr: @Model.Adr.ToString(System.Globalization.CultureInfo.InvariantCulture), kast: @Model.Kast, hs: @Model.Hs };
    const keys = ['rating', 'acs', 'kd', 'adr', 'kast', 'hs'];
    new Chart(document.getElementById('radar'), {
        type: 'radar',
        data: {
            labels: ['Rating', 'ACS', 'K:D', 'ADR', 'KAST', 'HS%'],
            datasets: [
                { label: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Nickname))', data: keys.map(k => Math.round(100 * me[k] / avg[k])), borderColor: '#ff4655', backgroundColor: 'rgba(255,70,85,.25)' },
                { label: `Avg ${avg.role} (${avg.players})`, data: keys.map(() => 100), borderColor: '#a49d97', backgroundColor: 'transparent', borderDash: [4, 4], pointRadius: 0 },
            ],
        },
        options: { scales: { r: { suggestedMin: 60, suggestedMax: 130, angleLines: { color: '#362e2e' }, grid: { color: '#362e2e' }, pointLabels: { color: '#f2eee7', font: { family: 'Barlow Condensed', size: 13, weight: 600 } }, ticks: { display: false } } } },
    });
})();
</script>
}
