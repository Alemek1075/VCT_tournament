@model Match
<div class="container-xl">
    <div class="page-head d-flex flex-wrap align-items-end gap-3">
        <div class="me-auto">
            <div class="kicker">C10 · C11 · same match, six transports</div>
            <h1>@Model.TeamA?.Tag vs @Model.TeamB?.Tag</h1>
            <p class="muted mb-0">Every panel follows the same live match on its own connection. Counters show what each approach costs.</p>
        </div>
        <button class="btn btn-red" id="start">Start / restart simulation</button>
        <button class="btn btn-ghost" id="reset">Reset counters</button>
    </div>

    <div class="row g-3" id="panels"></div>

    <h2 class="h4 mt-5">Comparison</h2>
    <div class="row g-3">
        <div class="col-lg-4"><div class="panel p-3"><div class="muted small mb-1">HTTP requests / frames sent by the client</div><canvas id="c-req" height="220"></canvas></div></div>
        <div class="col-lg-4"><div class="panel p-3"><div class="muted small mb-1">Bytes over the wire (incl. headers where measurable)</div><canvas id="c-bytes" height="220"></canvas></div></div>
        <div class="col-lg-4"><div class="panel p-3"><div class="muted small mb-1">Average delay after the server changed, ms</div><canvas id="c-lat" height="220"></canvas></div></div>
    </div>
    <div class="table-responsive mt-3">
        <table class="table" id="summary">
            <thead><tr><th>Transport</th><th class="text-end">Updates</th><th class="text-end">Missed</th><th class="text-end">Requests</th><th class="text-end">Empty replies</th><th class="text-end">KB</th><th class="text-end">Bytes/update</th><th class="text-end">Avg delay</th><th class="text-end">Max delay</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
    <p class="muted small">“Missed” = versions the client never saw (a poller can skip rounds that happen between two polls). Delay is corrected for the client/server clock offset.</p>
</div>

@section Head {
<style>
    .tp { background: var(--ink-2); border: 1px solid var(--line); padding: 1rem; height: 100%; }
    .tp h3 { font-size: 1.2rem; margin: 0; }
    .tp .sc { font-family: "Barlow Condensed"; font-weight: 800; font-size: 2.4rem; line-height: 1; margin: .5rem 0 .2rem; }
    .tp .ev { color: var(--muted); font-size: .85rem; min-height: 2.4em; }
    .tp dl { display: grid; grid-template-columns: 1fr auto; gap: 0 .8rem; margin: .6rem 0 0; font-size: .85rem; }
    .tp dt { color: var(--muted); font-weight: 400; }
    .tp dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
    .tp.flash { animation: flash .6s; }
    @@keyframes flash { from { border-color: var(--red); } }
    .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); margin-right: .3rem; }
    .dot.on { background: var(--teal); }
</style>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(async () => {
    const ID = @Model.Id;
    performance.setResourceTimingBufferSize(100000);
    const enc = new TextEncoder();
    let offset = 0; // serverTime - clientTime

    // clock offset: take the best of a few round trips
    async function calibrate() {
        let best = { rtt: 1e9, off: 0 };
        for (let i = 0; i < 5; i++) {
            const t0 = Date.now();
            const { now } = await fetch('/api/live/clock', { cache: 'no-store' }).then(r => r.json());
            const t1 = Date.now();
            if (t1 - t0 < best.rtt) best = { rtt: t1 - t0, off: now - (t0 + t1) / 2 };
        }
        offset = best.off;
    }
    await calibrate();

    const T = [
        { key: 'poll', name: 'Polling (2 s)', color: '#a49d97' },
        { key: 'adaptive', name: 'Adaptive polling + ETag', color: '#cfb473' },
        { key: 'long', name: 'Long polling', color: '#9d8cff' },
        { key: 'sse', name: 'Server-Sent Events', color: '#5ab0ff' },
        { key: 'ws', name: 'WebSocket (raw)', color: '#60ddc0' },
        { key: 'signalr', name: 'SignalR', color: '#ff4655' },
    ];
    const stats = {};
    const reset = () => T.forEach(t => stats[t.key] = { updates: 0, missed: 0, requests: 0, empty: 0, bytes: 0, lat: [], last: 0, open: false });
    reset();

    document.getElementById('panels').innerHTML = T.map(t => `
        <div class="col-md-6 col-xl-4"><div class="tp" id="p-${t.key}" style="border-top:3px solid ${t.color}">
            <h3><span class="dot" id="d-${t.key}"></span>${t.name}</h3>
            <div class="sc" id="s-${t.key}">–</div><div class="ev" id="e-${t.key}">waiting…</div>
            <dl id="m-${t.key}"></dl></div></div>`).join('');

    function got(key, s, bytes) {
        const st = stats[key];
        st.bytes += bytes;
        if (!s || s.version <= st.last) return;
        if (st.last) st.missed += s.version - st.last - 1;
        st.last = s.version;
        // the first message is a snapshot of an older state, not a fresh change: don't time it
        if (st.updates > 0) st.lat.push(Math.max(0, Date.now() + offset - s.serverTime));
        st.updates++;
        document.getElementById(`s-${key}`).textContent = `${s.mapsA}–${s.mapsB}  ·  ${s.roundsA}:${s.roundsB}`;
        document.getElementById(`e-${key}`).textContent = `${s.mapName} — ${s.lastEvent}`;
        const p = document.getElementById(`p-${key}`); p.classList.remove('flash'); void p.offsetWidth; p.classList.add('flash');
    }

    // fetch() with the real transfer size (headers + body) from Resource Timing when available
    async function measuredFetch(key, url, opts = {}) {
        stats[key].requests++;
        const r = await fetch(url, { cache: 'no-store', ...opts });
        const body = r.status === 200 ? await r.text() : '';
        await new Promise(res => setTimeout(res, 0));
        const e = performance.getEntriesByName(new URL(url, location.href).href).pop();
        const size = e && e.transferSize ? e.transferSize : body.length + 300; // ~300 B of headers if the browser hides it
        if (r.status !== 200) stats[key].empty++;
        return { status: r.status, body: body ? JSON.parse(body) : null, size, etag: r.headers.get('ETag') };
    }

    // 1. plain polling
    setInterval(async () => {
        const r = await measuredFetch('poll', `/api/live/${ID}`).catch(() => null);
        stats.poll.open = !!r; if (r) got('poll', r.body, r.size);
    }, 2000);

    // 2. adaptive polling: fast right after a change, backs off while nothing happens, 304 when unchanged
    (async function adaptive() {
        let delay = 500, etag = null;
        for (;;) {
            const r = await measuredFetch('adaptive', `/api/live/${ID}`, { headers: etag ? { 'If-None-Match': etag } : {} }).catch(() => null);
            stats.adaptive.open = !!r;
            if (r?.status === 200) { etag = r.etag; got('adaptive', r.body, r.size); delay = 500; }
            else { if (r) stats.adaptive.bytes += r.size; delay = Math.min(delay * 1.6, 8000); }
            await new Promise(res => setTimeout(res, delay));
        }
    })();

    // 3. long polling
    (async function longPoll() {
        for (;;) {
            const since = stats.long.last;
            const r = await measuredFetch('long', `/api/live/${ID}/wait?since=${since}`).catch(() => null);
            stats.long.open = !!r;
            if (r?.status === 200) got('long', r.body, r.size);
            else if (r) stats.long.bytes += r.size;
            else await new Promise(res => setTimeout(res, 2000));
        }
    })();

    // 4. SSE (one long response; count the event payloads + the initial response headers)
    const es = new EventSource(`/api/live/${ID}/sse`);
    stats.sse.requests = 1;
    es.onopen = () => { stats.sse.open = true; stats.sse.bytes += 250; };
    es.onerror = () => { stats.sse.open = false; stats.sse.requests++; };
    es.onmessage = e => got('sse', JSON.parse(e.data), enc.encode(`id: ${e.lastEventId}\ndata: ${e.data}\n\n`).length);

    // 5. raw WebSocket (upgrade handshake ≈ 450 B, then 2–4 B frame header per message)
    function ws() {
        const s = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws/live/${ID}`);
        stats.ws.requests++;
        s.onopen = () => { stats.ws.open = true; stats.ws.bytes += 450; };
        s.onmessage = e => { if (e.data !== 'pong') got('ws', JSON.parse(e.data), enc.encode(e.data).length + 4); };
        s.onclose = () => { stats.ws.open = false; setTimeout(ws, 2000); };
    }
    ws();

    // 6. SignalR (negotiate + WebSocket, JSON hub protocol frames end with 0x1E)
    const hub = new signalR.HubConnectionBuilder().withUrl('/hubs/live').withAutomaticReconnect().build();
    hub.on('state', s => got('signalr', s, enc.encode(JSON.stringify({ type: 1, target: 'state', arguments: [s] })).length + 5));
    hub.onreconnected(() => hub.invoke('Join', ID));
    await hub.start();
    stats.signalr.requests = 2; stats.signalr.bytes += 900; // negotiate POST + upgrade
    stats.signalr.open = true;
    got('signalr', await hub.invoke('Join', ID), 0);

    // ---- render
    const bar = id => new Chart(document.getElementById(id), {
        type: 'bar',
        data: { labels: T.map(t => t.name.split(' (')[0]), datasets: [{ data: T.map(() => 0), backgroundColor: T.map(t => t.color), borderWidth: 0 }] },
        options: { animation: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#a49d97', font: { size: 10 } } }, y: { ticks: { color: '#a49d97' }, grid: { color: '#362e2e' } } } },
    });
    const charts = { req: bar('c-req'), bytes: bar('c-bytes'), lat: bar('c-lat') };
    const avg = a => a.length ? Math.round(a.reduce((x, y) => x + y, 0) / a.length) : 0;

    setInterval(() => {
        T.forEach(t => {
            const s = stats[t.key];
            document.getElementById(`d-${t.key}`).classList.toggle('on', s.open);
            document.getElementById(`m-${t.key}`).innerHTML = `
                <dt>updates</dt><dd>${s.updates}</dd><dt>missed versions</dt><dd>${s.missed}</dd>
                <dt>requests / connects</dt><dd>${s.requests}</dd><dt>empty replies</dt><dd>${s.empty}</dd>
                <dt>traffic</dt><dd>${(s.bytes / 1024).toFixed(1)} KB</dd><dt>avg delay</dt><dd>${avg(s.lat)} ms</dd>`;
        });
        charts.req.data.datasets[0].data = T.map(t => stats[t.key].requests);
        charts.bytes.data.datasets[0].data = T.map(t => Math.round(stats[t.key].bytes / 1024 * 10) / 10);
        charts.lat.data.datasets[0].data = T.map(t => avg(stats[t.key].lat));
        Object.values(charts).forEach(c => c.update());
        document.querySelector('#summary tbody').innerHTML = T.map(t => {
            const s = stats[t.key];
            return `<tr><td>${t.name}</td><td class="text-end">${s.updates}</td><td class="text-end">${s.missed}</td><td class="text-end">${s.requests}</td>
                <td class="text-end">${s.empty}</td><td class="text-end">${(s.bytes / 1024).toFixed(1)}</td>
                <td class="text-end">${s.updates ? Math.round(s.bytes / s.updates) : 0}</td><td class="text-end">${avg(s.lat)} ms</td>
                <td class="text-end">${s.lat.length ? Math.max(...s.lat) : 0} ms</td></tr>`;
        }).join('');
    }, 1000);

    document.getElementById('start').addEventListener('click', async () => { reset(); await fetch(`/api/live/${ID}/start`, { method: 'POST' }); });
    document.getElementById('reset').addEventListener('click', () => { const last = Object.fromEntries(T.map(t => [t.key, stats[t.key].last])); reset(); T.forEach(t => stats[t.key].last = last[t.key]); });
    window.liveStats = stats; // handy for the report / console
})();
</script>
}
