@model string
@section Head { <link rel="stylesheet" href="~/css/board.css" asp-append-version="true" /> }

<div class="board-shell">
    <aside class="board-tools">
        <div class="kicker">Room · @Model</div>
        <button class="btn btn-ghost btn-sm w-100 mb-3" id="copy-link">Copy invite link</button>

        <label class="form-label" for="map-select">Map</label>
        <select id="map-select" class="form-select mb-3"></select>

        <div class="form-label">Tool</div>
        <div class="tool-row mb-2" id="tools">
            <button data-tool="pen" class="on" title="Pen (P)">✎</button>
            <button data-tool="arrow" title="Arrow (A)">➚</button>
            <button data-tool="move" title="Move markers (M)">✥</button>
            <button data-tool="erase" title="Eraser (E)">⌫</button>
        </div>
        <div class="tool-row mb-3" id="colors">
            <button data-color="#ff4655" class="on" style="--c:#ff4655"></button>
            <button data-color="#60ddc0" style="--c:#60ddc0"></button>
            <button data-color="#cfb473" style="--c:#cfb473"></button>
            <button data-color="#f2eee7" style="--c:#f2eee7"></button>
            <button data-color="#5ab0ff" style="--c:#5ab0ff"></button>
        </div>

        <div class="form-label d-flex justify-content-between">Agents
            <span><label class="small"><input type="radio" name="side" value="atk" checked> atk</label> <label class="small"><input type="radio" name="side" value="def"> def</label></span>
        </div>
        <div class="agents mb-3" id="agents"></div>

        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-ghost btn-sm flex-fill" id="undo" title="Ctrl+Z">Undo</button>
            <button class="btn btn-ghost btn-sm flex-fill" id="clear">Clear</button>
            <button class="btn btn-ghost btn-sm flex-fill" id="png">PNG</button>
        </div>

        <div class="form-label">Voice (WebRTC)</div>
        <button class="btn btn-red btn-sm w-100 mb-2" id="voice">🎙 Join voice</button>
        <div id="voice-peers" class="small muted mb-3"></div>

        <div class="form-label">People here</div>
        <div id="peers" class="mb-3"></div>

        <p class="muted small">Drop any image (File API) onto the board to plan on your own screenshot. Everything is live for everyone in the room.</p>
    </aside>

    <main class="board-stage" id="stage">
        <div class="board-square" id="square">
            <img id="map-img" alt="Map" crossorigin="anonymous" />
            <canvas id="canvas"></canvas>
            <div id="cursors"></div>
            <div class="drop-hint" id="drop-hint">Drop the image to use it as the map</div>
        </div>
    </main>
</div>
<div id="audio-sink" hidden></div>

@section Scripts {
    <script>window.BOARD = { room: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model)), signedIn: @(User.Identity?.IsAuthenticated == true ? "true" : "false") };</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/board.js" asp-append-version="true"></script>
}
